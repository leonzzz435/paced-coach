# Next.js local environment example.
# Copy to web/app/.env.local for local development. Do not commit real secrets.

# Backend API. Defaults to localhost when unset.
API_BASE_URL=http://localhost:8000
API_FETCH_TIMEOUT_MS=30000
NEXT_PUBLIC_AUTH_MODE=local

# Local data deletion is disabled by default.
NEXT_PUBLIC_ALLOW_LOCAL_DATA_DELETE=false
